# ─── SepsisAI BEI API v2.0 — Environment Variables ──────────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sepsisai:changeme@localhost:5432/sepsisai
# Set to "true" to echo SQL queries to stdout (development only)
DB_ECHO=false

# ── Authentication ────────────────────────────────────────────────────────────
# Admin key for hospital registration endpoints.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=

# ── Claude / Anthropic ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=3000

# ── ChromaDB / RAG ────────────────────────────────────────────────────────────
CHROMA_PATH=/data/chroma_db
COLLECTION_NAME=sepsisai_full_collection_2026
EMBED_MODEL=NeuML/pubmedbert-base-embeddings
TOP_K=25
FINAL_K=10
MIN_YEAR=2015

# ── Legacy output dir (kept for CLI / script use) ─────────────────────────────
OUTPUT_DIR=/data/patient_cache
